#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <ArduinoJson.h>
#include <time.h>
#include "iot_secrets.h"

constexpr int ECHO_PIN = 18, TRIGGER_PIN = 5, RED_LED = 22, GREEN_LED = 21;
constexpr float OCCUPIED_THRESHOLD = 10.0f, FREE_THRESHOLD = 20.0f;
constexpr unsigned long STABLE_TIME = 15000, MIN_INTERVAL = 3000;
WiFiClientSecure client;
String accessToken;
unsigned long authenticatedAt = 0, tokenLifetime = 0, lastAuthAttempt = 0;
unsigned long candidateSince = 0, lastSend = 0, lastReconnect = 0;
bool currentState = false, candidateState = false, sentState = false, hasSynced = false;

float readDistance() {
  digitalWrite(TRIGGER_PIN, LOW); delayMicroseconds(2);
  digitalWrite(TRIGGER_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIGGER_PIN, LOW);
  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  return duration ? duration / 58.2f : -1;
}

bool authenticateDevice() {
  unsigned long now = millis();
  if (accessToken.length() && now - authenticatedAt < tokenLifetime) return true;
  if (now - lastAuthAttempt < 5000) return false;
  lastAuthAttempt = now;
  HTTPClient http;
  if (!http.begin(client, String(SUPABASE_URL) + "/auth/v1/token?grant_type=password")) return false;
  http.setTimeout(5000);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("apikey", SUPABASE_PUBLISHABLE_KEY);
  JsonDocument credentials;
  credentials["email"] = SUPABASE_DEVICE_EMAIL;
  credentials["password"] = SUPABASE_DEVICE_PASSWORD;
  String body; serializeJson(credentials, body);
  int code = http.POST(body);
  JsonDocument response;
  bool valid = code == 200 && !deserializeJson(response, http.getString());
  if (valid) {
    accessToken = response["access_token"].as<String>();
    unsigned long seconds = response["expires_in"] | 3600UL;
    if (seconds > 86400) seconds = 86400;
    tokenLifetime = seconds > 60 ? (seconds - 60) * 1000UL : 0;
    authenticatedAt = millis();
  }
  http.end();
  return valid && accessToken.length() && tokenLifetime;
}

bool sendToSupabase(bool occupied) {
  // Require Wi-Fi, a synchronized clock, and a configured CA before sending credentials.
  if (WiFi.status() != WL_CONNECTED || time(nullptr) < 1700000000 ||
      strlen(SUPABASE_ROOT_CA) < 100 || !authenticateDevice()) return false;
  HTTPClient http;
  if (!http.begin(client, String(SUPABASE_URL) + "/rest/v1/rpc/sync_spot")) return false;
  http.setTimeout(5000);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("apikey", SUPABASE_PUBLISHABLE_KEY);
  http.addHeader("Authorization", "Bearer " + accessToken);
  int code = http.POST(String("{\"p_detected\":") + (occupied ? "true" : "false") + "}");
  if (code == 401) accessToken = "";
  Serial.printf("Occupancy update HTTP status: %d\n", code);
  http.end();
  return code >= 200 && code < 300;
}

void setup() {
  Serial.begin(115200);
  pinMode(TRIGGER_PIN, OUTPUT); pinMode(ECHO_PIN, INPUT);
  pinMode(RED_LED, OUTPUT); pinMode(GREEN_LED, OUTPUT);
  WiFi.mode(WIFI_STA); WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  client.setCACert(SUPABASE_ROOT_CA);
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  candidateSince = millis();
}

void loop() {
  unsigned long now = millis();
  if (WiFi.status() != WL_CONNECTED && now - lastReconnect >= 10000) {
    lastReconnect = now; WiFi.reconnect();
  }
  float distance = readDistance();
  if (distance > 0) {
    bool detected = candidateState;
    if (distance <= OCCUPIED_THRESHOLD) detected = true;
    else if (distance > FREE_THRESHOLD) detected = false;
    if (detected != candidateState) { candidateState = detected; candidateSince = now; }
    if (now - candidateSince >= STABLE_TIME) {
      currentState = candidateState;
      if ((!hasSynced || sentState != currentState) && now - lastSend >= MIN_INTERVAL) {
        lastSend = now;
        if (sendToSupabase(currentState)) { sentState = currentState; hasSynced = true; }
      }
    }
  } else {
    // Invalid readings must not count toward a stable observation.
    candidateSince = now;
  }
  digitalWrite(RED_LED, currentState ? HIGH : LOW);
  digitalWrite(GREEN_LED, currentState ? LOW : HIGH);
  delay(200);
}
