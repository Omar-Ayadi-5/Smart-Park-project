# Copy to .env and supply your own values. Never commit .env.
# For a local web demo you may use DATABASE_URL=sqlite:///smartpark.db.
# PostgreSQL is required for the device RPC integration.
DATABASE_URL=postgresql://smart_park:replace_with_database_password@localhost:5432/smart_park

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_secret_generated_locally

# Comma-separated frontend origins; no trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Enable only for local development. Production should use a WSGI server.
FLASK_DEBUG=0

# Single-process development; use redis://host:6379/0 across production workers.
RATELIMIT_STORAGE_URI=memory://
